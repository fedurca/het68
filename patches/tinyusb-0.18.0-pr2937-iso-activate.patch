+    hw_endpoint_abort_xfer(ep); // abort any pending transfer (PR #2937 backport)
+  }
 
+  ep->wMaxPacketSize = ep_desc->wMaxPacketSize;
   hw_endpoint_enable(ep);
   return true;
 }
--- a/src/portable/raspberrypi/rp2040/rp2040_usb.c
+++ b/src/portable/raspberrypi/rp2040/rp2040_usb.c
@@ -304,6 +304,15 @@ bool __tusb_irq_path_func(hw_endpoint_xfer_continue)(struct hw_endpoint* ep) {
 
   // Part way through a transfer
   if (!ep->active) {
+    // Fix: RP2040 ISO hardware fires buf_status on every SOF even when no buffer
+    // was prepared (AVAIL not set) — the hardware sent a ZLP. After fix #2
+    // (hw_endpoint_reset_transfer before dcd_event_xfer_complete) ep->active is
+    // false for one SOF window. Don't panic; report a 0-byte "done" so the audio
+    // driver reloads the next buffer immediately.
+    if (ep->transfer_type == TUSB_XFER_ISOCHRONOUS) {
+      hw_endpoint_lock_update(ep, -1);
+      return true; // 0-byte done — xferred_len is already 0 from reset
+    }
     panic("Can't continue xfer on inactive ep %02X", ep->ep_addr);
   }
 
