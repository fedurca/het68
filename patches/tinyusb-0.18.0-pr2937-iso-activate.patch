From: TinyUSB backport: PR #2937 + commit 4bfba6b + ISO ZLP fix
Subject: rp2040: three ISO transfer fixes for UAC2 streaming on pico-sdk 0.18.0

All three bugs interact: fix #1 gets SET_INTERFACE past the first panic;
fix #2 gets the first few frames working; fix #3 prevents the steady-state
panic from ISO hardware firing buf_status even when no buffer was prepared.

Fix 1 (PR #2937, merged 2025-03-07 — dcd_rp2040.c):
  dcd_edpt_iso_activate() did not abort an in-flight ISO transfer before
  re-enabling the endpoint on SET_INTERFACE.  Caused hard panic
  ("ep 81 was already available") on the very first SET_INTERFACE from
  the Linux UAC2 driver → device completely unresponsive (-110 ETIMEDOUT).

Fix 2 (commit 4bfba6b, 2025-08-05 — dcd_rp2040.c):
  hw_handle_buff_status() notified the stack (dcd_event_xfer_complete)
  BEFORE resetting ep->active.  The audio class driver queues the next
  ISO transfer from within the xfer-complete callback (ISR), so
  hw_endpoint_xfer_start() would find ep->active == true and assert
  "ep XX was already available", crashing the firmware ~50 s after start.

Fix 3 (new — rp2040_usb.c):
  RP2040/2350 USB hardware fires buf_status for ISO IN on every SOF,
  including SOFs where no buffer was prepared (AVAIL bit not set) and the
  hardware automatically sent a ZLP.  After fix #2 resets ep->active to
  false, the very next SOF fires buf_status → hw_endpoint_xfer_continue()
  sees active==false → panic "Can't continue xfer on inactive ep".
  Fix: for ISO endpoints, treat inactive buf_status as a 0-byte "done"
  so the audio driver immediately reloads the buffer for the next frame.

Upstream references:
  https://github.com/hathach/tinyusb/pull/2937
  https://github.com/hathach/tinyusb/commit/4bfba6b09a90d5321b3dbd2d986760438417c430

--- a/src/portable/raspberrypi/rp2040/dcd_rp2040.c
+++ b/src/portable/raspberrypi/rp2040/dcd_rp2040.c
@@ -148,6 +148,34 @@ static void hw_endpoint_xfer(uint8_t ep_addr, uint8_t* buffer, uint16_t total_by
   hw_endpoint_xfer_start(ep, buffer, total_bytes);
 }
 
+// Abort any pending transfer on the given endpoint.
+// Backport of TinyUSB PR #2937: required to safely re-activate an ISO IN
+// endpoint whose previous isochronous transfer is still in flight when the
+// host issues SET_INTERFACE to restart streaming.
+// Due to Errata RP2040-E2: ABORT flag is only applicable for B2 and later
+// (unusable for B0, B1). We are not guaranteed to safely abort on B0/B1.
+static void hw_endpoint_abort_xfer(struct hw_endpoint* ep) {
+  const uint8_t dir = tu_edpt_dir(ep->ep_addr);
+  const uint8_t epnum = tu_edpt_number(ep->ep_addr);
+  const uint32_t abort_mask = TU_BIT((epnum << 1) | (dir ? 0 : 1));
+  if (rp2040_chip_version() >= 2) {
+    usb_hw_set->abort = abort_mask;
+    while ((usb_hw->abort_done & abort_mask) != abort_mask) {}
+  }
+
+  uint32_t buf_ctrl = USB_BUF_CTRL_SEL; // reset to buffer 0
+  if (ep->next_pid) {
+    buf_ctrl |= USB_BUF_CTRL_DATA1_PID;
+  }
+  _hw_endpoint_buffer_control_set_value32(ep, buf_ctrl);
+  hw_endpoint_reset_transfer(ep);
+
+  if (rp2040_chip_version() >= 2) {
+    usb_hw_clear->abort_done = abort_mask;
+    usb_hw_clear->abort = abort_mask;
+  }
+}
+
 static void __tusb_irq_path_func(hw_handle_buff_status)(void) {
   uint32_t remaining_buffers = usb_hw->buf_status;
   pico_trace("buf_status = 0x%08lx\r\n", remaining_buffers);
@@ -163,9 +191,13 @@ static void __tusb_irq_path_func(hw_handle_buff_status)(void) {
       // Continue xfer
       bool done = hw_endpoint_xfer_continue(ep);
       if (done) {
-        // Notify
-        dcd_event_xfer_complete(0, ep->ep_addr, ep->xferred_len, XFER_RESULT_SUCCESS, true);
+        // Reset transfer state BEFORE notifying the stack (backport of TinyUSB commit 4bfba6b,
+        // Aug 2025). The audio class driver now queues the next ISO transfer from within the
+        // xfer-complete callback (ISR context). If ep->active is still true at that point,
+        // hw_endpoint_xfer_start() hard-asserts "ep XX was already available".
+        uint16_t const xferred_len = ep->xferred_len;
         hw_endpoint_reset_transfer(ep);
+        dcd_event_xfer_complete(0, ep->ep_addr, xferred_len, XFER_RESULT_SUCCESS, true);
       }
       remaining_buffers &= ~bit;
     }
@@ -178,25 +210,10 @@ TU_ATTR_ALWAYS_INLINE static inline void reset_ep0(void) {
   // setup transfer. Also clear a stall in case
   for (uint8_t dir = 0; dir < 2; dir++) {
     struct hw_endpoint* ep = hw_endpoint_get_by_num(0, dir);
+    ep->next_pid = 1u;
     if (ep->active) {
-      // Abort any pending transfer from a prior control transfer per USB specs
-      // Due to Errata RP2040-E2: ABORT flag is only applicable for B2 and later (unusable for B0, B1).
-      // Which means we are not guaranteed to safely abort pending transfer on B0 and B1.
-      uint32_t const abort_mask = (dir ? USB_EP_ABORT_EP0_IN_BITS : USB_EP_ABORT_EP0_OUT_BITS);
-      if (rp2040_chip_version() >= 2) {
-        usb_hw_set->abort = abort_mask;
-        while ((usb_hw->abort_done & abort_mask) != abort_mask) {}
-      }
-
-      _hw_endpoint_buffer_control_set_value32(ep, USB_BUF_CTRL_DATA1_PID | USB_BUF_CTRL_SEL);
-      hw_endpoint_reset_transfer(ep);
-
-      if (rp2040_chip_version() >= 2) {
-        usb_hw_clear->abort_done = abort_mask;
-        usb_hw_clear->abort = abort_mask;
-      }
+      hw_endpoint_abort_xfer(ep); // Abort any pending transfer per USB specs
     }
-    ep->next_pid = 1u;
   }
 }
 
@@ -495,12 +512,14 @@ bool dcd_edpt_iso_alloc(uint8_t rhport, uint8_t ep_addr, uint16_t largest_packet
 // New API: Configure and enable an ISO endpoint according to descriptor
 bool dcd_edpt_iso_activate(uint8_t rhport, tusb_desc_endpoint_t const * ep_desc) {
   (void) rhport;
-  const uint8_t ep_addr = ep_desc->bEndpointAddress;
-  // Fill in endpoint control register with buffer offset
-  struct hw_endpoint* ep = hw_endpoint_get_by_addr(ep_addr);
-  TU_ASSERT(ep->hw_data_buf != NULL); // must be inited and buffer allocated
-  ep->wMaxPacketSize = ep_desc->wMaxPacketSize;
+  struct hw_endpoint* ep = hw_endpoint_get_by_addr(ep_desc->bEndpointAddress);
+  TU_ASSERT(ep->hw_data_buf != NULL); // must be inited and allocated previously
