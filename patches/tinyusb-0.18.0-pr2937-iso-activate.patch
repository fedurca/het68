+    hw_endpoint_abort_xfer(ep); // abort any pending transfer (PR #2937 backport)
+  }
+
+  ep->wMaxPacketSize = ep_desc->wMaxPacketSize;
   hw_endpoint_enable(ep);
   return true;
 }
diff --git a/src/portable/raspberrypi/rp2040/rp2040_usb.c b/src/portable/raspberrypi/rp2040/rp2040_usb.c
index 43f48da..bbb5a40 100644
--- a/src/portable/raspberrypi/rp2040/rp2040_usb.c
+++ b/src/portable/raspberrypi/rp2040/rp2040_usb.c
@@ -304,6 +304,19 @@ bool __tusb_irq_path_func(hw_endpoint_xfer_continue)(struct hw_endpoint* ep) {
 
   // Part way through a transfer
   if (!ep->active) {
+    // Fix: RP2040 ISO hardware fires buf_status on every SOF even when no buffer
+    // was prepared (AVAIL not set) — hardware sent a ZLP for that frame. After
+    // fix #2 (reset before notify) ep->active is false for up to one SOF window
+    // while tud_task processes the previous xfer_complete and queues the next
+    // transfer. Returning true (done) would post a spurious xfer_complete event;
+    // tud_task would then start a second transfer while the first (just queued
+    // by the real event) still has AVAIL set → "ep already available" panic.
+    // Return false instead: ignore the ZLP interrupt silently; the real
+    // xfer_complete event already in the queue will reload the buffer.
+    if (ep->transfer_type == TUSB_XFER_ISOCHRONOUS) {
+      hw_endpoint_lock_update(ep, -1);
+      return false; // spurious ZLP SOF — ignore, real event handles reload
+    }
     panic("Can't continue xfer on inactive ep %02X", ep->ep_addr);
   }
 
