; I2S slave RX, phase-locked to the on-chip master clock SM (i2s_clk).
;
; Rationale: gating `in` on the external SCK with `wait gpio` is unreliable here
; because the data SM and the clock SM run at different clkdivs; the GPIO input
; synchroniser races the short SCK-high window and we capture a varying number
; of bits per slot (garbage / dropped bits / oversampling).
;
; Instead this program mirrors the clock SM cycle-for-cycle. Both SMs use the
; SAME clkdiv and are started together with pio_enable_sm_mask_in_sync(), so they
; stay in lock-step forever (neither stalls in steady state). We therefore know
; exactly which SM cycle each SCK edge happens on and sample once per bit at a
; fixed phase — fully deterministic, no GPIO waits.
;
; Cycle layout per channel bit (mirrors i2s_clk: nop side1 / nop side0 / jmp):
;   c0: SCK rising  <- sample here ('in pins, 1')
;   c1: SCK high/falling
;   c2: SCK low (jmp)
; Frame = 2 setup + 32*3 (left) + 2 setup + 32*3 (right) = 196 cycles, identical
; to the clock SM, so the two programs never drift apart.
;
; MSB-first: shift LEFT + autopush(32) so the first sampled bit ends up in the
; ISR MSB. A fixed whole-bit offset (I2S 1-bit delay) is corrected on the C side.
.program i2s_rx
.define public PIN_SCK 1

.wrap_target
    nop                              ; mirror clk "set pins,0 side0" (WS low)
    set x, 31                        ; mirror clk "set x,31"
left_loop:
    in pins, 1                       ; c0: sample SD at SCK rising edge
    nop                              ; c1
    jmp x-- left_loop                ; c2

    nop                              ; mirror clk "set pins,1 side0" (WS high)
    set x, 31                        ; mirror clk "set x,31"
right_loop:
    in pins, 1                       ; c0: sample SD at SCK rising edge
    nop                              ; c1
    jmp x-- right_loop               ; c2
.wrap
