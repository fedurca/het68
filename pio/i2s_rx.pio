; I2S slave RX: read SD on rising/falling edges of external SCK (GP1).
; WS (GP0) selects left/right phase. Clock SM must drive WS+SCK first.
.program i2s_rx
.define public PIN_SCK 1

.wrap_target
    wait 0 pin 0                      ; WS == 0 (left)
    set x, 15
left_loop:
    wait 1 gpio PIN_SCK
    in pins, 1
    wait 0 gpio PIN_SCK
    jmp x-- left_loop

push

    wait 1 pin 0                      ; WS == 1 (right)
    set x, 15
right_loop:
    wait 1 gpio PIN_SCK
    in pins, 1
    wait 0 gpio PIN_SCK
    jmp x-- right_loop

push
.wrap
